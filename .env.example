# Copy this file to .env next to bin_to_audio_windows.ps1.
# Never commit the real .env file or share its API keys.

# None | Google | AI | GoogleThenAI | AIThenGoogle
LYRICS_TRANSLATION_FALLBACK=AIThenGoogle

# Auto tries each fully configured AI format in this order: OpenAI, Anthropic.
# You can force one format with OpenAI or Anthropic.
AI_TRANSLATION_PROVIDER=Auto

# Google Cloud Translation Basic v2
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2

# Microsoft Azure AI Translator v3. Region is required by many regional or
# multi-service resources, but can be left blank when the Azure resource does
# not require the Ocp-Apim-Subscription-Region header.
MICROSOFT_TRANSLATOR_API_KEY=
MICROSOFT_TRANSLATOR_BASE_URL=https://api.cognitive.microsofttranslator.com
MICROSOFT_TRANSLATOR_REGION=

# Modes that include Google also end with two no-key, best-effort consumer
# fallbacks: Google GTX, then Bing Translator web. They need no variables here,
# are undocumented service contracts, and may be rate-limited or changed.

# OpenAI Chat Completions format. OPENAI_BASE_URL may point to an
# OpenAI-compatible gateway. Set the API root only; the script appends
# /chat/completions. Do not include a query string or credentials in this URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Anthropic Messages format. ANTHROPIC_BASE_URL may point to an
# Anthropic-compatible gateway. Set the API root only; the script appends
# /messages. Do not include a query string or credentials in this URL.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096

# Optional: path to a UTF-8 custom system prompt. Relative paths are resolved
# from the directory that contains .env. Leave blank to use the built-in
# “信、达、雅” lyrics translation prompt.
AI_TRANSLATION_PROMPT_FILE=
