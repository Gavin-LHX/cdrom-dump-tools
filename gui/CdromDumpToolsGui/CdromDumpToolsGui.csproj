<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CdromDumpToolsGui</RootNamespace>
    <AssemblyName>CdromDumpToolsGui</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>CD-ROM Dump Tools GUI</Product>
    <Description>Graphical wrapper for the cdrom-dump-tools Windows converter</Description>
  </PropertyGroup>

</Project>
