<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CdromDumpToolsGui</RootNamespace>
    <AssemblyName>CdromDumpToolsGui</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <Version>2.14.0</Version>
    <Product>CD-ROM Dump Tools GUI</Product>
    <Description>Windows graphical interface for cdrom-dump-tools</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\bin_to_audio_windows.ps1"
                      Link="Resources\bin_to_audio_windows.ps1"
                      LogicalName="CdromDumpToolsGui.Resources.bin_to_audio_windows.ps1" />
  </ItemGroup>

</Project>
